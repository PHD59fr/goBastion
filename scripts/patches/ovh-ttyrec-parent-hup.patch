@@ -1630,6 +1658,10 @@
         kill(subchild, SIGTERM);
         (void)puts("\r\nttyrec: ending your session, sorry (kill timeout expired, you manually typed the kill key sequence, or we got a SIGTERM).\r");
     }
+    else if (child > 0)
+    {
+        kill(child, SIGTERM);
+    }
     done(EXIT_SUCCESS);
 }
 
@@ -1640,6 +1672,11 @@
     if (subchild > 0)
     {
         kill(subchild, SIGTERM);
+    }
+    else if (child > 0)
+    {
+        // The caller may signal only the outer parent, including on parent death.
